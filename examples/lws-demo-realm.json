{
  "realm": "lws-demo",
  "enabled": true,
  "displayName": "LWS demo (development only: a known password, not for a real server)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "lws-verifier",
        "description": "May call the lws-authn verify endpoints, which a bearer caller needs this role for. alice holds it so the demo scripts can verify with her token; in a real deployment grant it to the authorization server's service account, not to end users."
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "lws-app",
      "name": "LWS demo app",
      "description": "Public client for trying out LWS authentication, for development only. It allows only the password grant, to make the walkthroughs easy to script, and no browser flow and no redirect URIs: a public client with a wildcard redirect is an authorization-code theft vector.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "lws-webid-sub",
          "protocol": "openid-connect",
          "protocolMapper": "lws-webid-sub-mapper",
          "consentRequired": false,
          "config": {
            "lws.webid.attribute": "",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "fb147f85-59e9-4288-a907-38aa2d4a33b5",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.org",
      "realmRoles": ["lws-verifier"],
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ]
    }
  ]
}
